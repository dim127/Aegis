{
  "exchange": {
    "name": "binance",
    "trading_mode": "futures",
    "sandbox": false,
    "rate_limit": true,
    "hyperliquid": {
      "enabled": true,
      "wallet_address": "",
      "private_key": ""
    }
  },
  "pairlist": {
    "pairlist_handlers": [
      {
        "method": "VolumePairList",
        "parameters": {
          "number_assets": 20,
          "sort_key": "quoteVolume",
          "min_volume": 100000,
          "exchange": "binance",
          "quote_currency": "USDT"
        }
      },
      {
        "method": "PriceFilter",
        "parameters": {
          "min_price": 0.000001,
          "max_price": 100000,
          "low_price_ratio": 0.01
        }
      },
      {
        "method": "SpreadFilter",
        "parameters": {
          "max_spread_ratio": 0.005
        }
      }
    ],
    "hyperliquid_pairlist": {
      "enabled": true,
      "method": "HyperliquidMajorPairList",
      "parameters": {
        "number_assets": 30,
        "min_volume": 100000
      }
    },
    "blacklist": ["USDT/USD", "BUSD/USD", "DAI/USD", "TUSD/USD"],
    "static_pairs": ["BTC/USDT", "ETH/USDT", "SOL/USDT", "BNB/USDT", "XRP/USDT", "ADA/USDT", "AVAX/USDT", "DOGE/USDT", "LINK/USDT", "DOT/USDT"]
  },
  "scoring": {
    "threshold": 65,
    "technical_max": 40,
    "volume_max": 20,
    "market_structure_max": 20,
    "derivatives_max": 20,
    "sentiment_max": 10
  },
  "risk": {
    "protections": [
      {
        "method": "StoplossGuard",
        "parameters": {
          "lookback_hours": 24,
          "trade_limit": 3,
          "stop_duration_hours": 4,
          "only_per_pair": false
        }
      },
      {
        "method": "MaxDrawdown",
        "parameters": {
          "max_drawdown": 0.15,
          "stop_duration_hours": 12,
          "trade_limit": 10
        }
      },
      {
        "method": "LowProfitPairs",
        "parameters": {
          "lookback_days": 7,
          "trade_limit": 3,
          "stop_duration_hours": 24,
          "required_profit": 0.0
        }
      },
      {
        "method": "CooldownPeriod",
        "parameters": {
          "cooldown_hours": 4,
          "only_per_pair": true
        }
      }
    ],
    "position_sizing": {
      "risk_per_trade": 0.01,
      "max_position_size": null,
      "min_position_size": null
    }
  },
  "backtest": {
    "start_capital": 1000.0,
    "fee": 0.0007,
    "slippage": 0.0005,
    "leverage": 1.0,
    "max_open_trades": 3,
    "stake_amount": 30.0,
    "timerange": "180d",
    "interval": "1h"
  },
  "hyperopt": {
    "epochs": 100,
    "loss_function": "sharpe",
    "random_state": 42,
    "early_stop": 20,
    "n_initial_points": 10,
    "acq_func": "gp_hedge"
  },
  "multi_tf_scoring": {
    "enabled": true,
    "timeframes": ["1h", "4h", "1d"],
    "weights": {"1h": 0.50, "4h": 0.30, "1d": 0.20},
    "discount_on_conflict": 0.15,
    "bonus_on_agreement": 0.10
  },
  "scanner": {
